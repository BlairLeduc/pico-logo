; P17 M0 -- the harness, and the three questions.
;
;   erall                   <-- REQUIRED, a stale workspace steals nodes
;   load "p17m0
;   p17m0
;
; This is the gate in docs/daggorath-design.md section 15/12: a worst-case
; redraw under 100 ms at 300 MHz on all three boards, with the 150 MHz
; figure taken alongside it. Nothing is built on top of this design until
; it runs, because section 6.3 -- how to walk 100-250 numbers a redraw
; without allocating -- is "the number most likely to be wrong, by a lot
; in either direction" and every other budget line in section 12 is
; predicted from it.
;
; FOUR QUESTIONS, in the design's own order (section 15):
;
;   Q1  Which of section 6.3's three list walks, and does it allocate?
;       `item` with a running index (quadratic); `first`/`butfirst` down
;       the list (linear, and the open question is whether `butfirst`
;       conses); `foreach` over one list per polyline (a lambda call a
;       point). Timed on a single 55-point shape, `nodes` and `atoms`
;       read WARM either side of 1,000 walks -- a cold reading charges
;       the first pass for interning and looks exactly like a leak.
;   Q2  Does the section 8 grey ramp read as a fade on a real panel, and
;       does the section 8.1 dot stroke read as the original's texture
;       beside a photograph of it? This script can only draw the two
;       ramps side by side (`p17m0.fade.demo`); the gate is a pair of
;       eyes, same as M1a's.
;   Q3  Does section 4.1's 1.25x land where the arithmetic says? Checked
;       against the four numbers section 6.2 works out by hand: at range
;       1, k = 1.25, kx0 = 160, c = 160, and X = 0/255, Y = 0/151 land at
;       x = -160/158.75, y = 160/-28.75.
;   Q4  Does this board take `hw.setcpu "fast`? Asked, not assumed, same
;       as P13 M0 -- a board (or the host) that refuses stays at whatever
;       it had and the report says so.
;
; THE SCENE is section 12's worst case: a nine-deep corridor (so the walk
; never stops early), a creature in the near cell, a creature peeking on
; each side, and three objects on the floor. `scripts/gen_daggorath.py`
; does not exist yet -- that is M1's job -- so every shape below is a
; HAND-WRITTEN stand-in, not real ROM data, with one exception: the left
; wall outline IS `VARC.ASM:LWALL`, transcribed in the design at section
; 6.2 (`16 27 38 64 114 64 136 27`), because having one real table to
; check the transform against is worth more than a matching synthetic
; one. The right wall is that table mirrored in x; the ceiling line, the
; peeks and the three floor objects are small hand-drawn placeholders;
; the creature is 55 points -- the ROM's own D3/D4 average from design
; section 11.1 -- generated by a deterministic formula rather than typed
; by hand, so its POINT COUNT is representative even though its SHAPE is
; not. All of it gets replaced by the generator's real output at M1; nothing
; here is meant to survive that.
;
; WHY 55 POINTS AND NOT SOMETHING ELSE. Section 11.1: ~350 points over 7
; creatures in D3, ~380 over 6 in D4 -- an average of about 55. Section
; 6.3's own arithmetic ("a 60-point creature is 120 `item` calls") is the
; same figure rounded, and confirms the encoding this harness assumes:
; flat `y x y x ...` bytes, two `item` calls a point.
;
; `erall` is not optional, for the reason P13 M0 and P18 both give: a
; workspace already holding another program can run out of procedure
; slots before this one is defined.
;
; The report goes to `p17m0.txt` as well as the screen, because numbers
; on the PicoCalc's display cannot be copied anywhere. Runs append.

;==========================================================================
; The scale tables, section 6.1, verbatim -- radix-7 (divide by 128),
; indexed by range 0-9.

make "p17m0.norscl [200 128 80 50 31 20 12 8 4 2]
make "p17m0.hlfscl [255 156 100 65 40 26 16 10 6 3]

; The near cell -- where the creature, the two peeks and the three
; objects sit. Range 0 is the first entry VIEWER.ASM's own loop reads
; (`range := 0` before the loop, not after), so it is the nearest thing
; drawn and the worst case for "everything in one cell."
make "p17m0.near 0

;==========================================================================
; The transform, section 6.2: three constants a range, two multiplies and
; two subtracts a point.
;
;   scale = table[range] / 128
;   k     = 1.25 * scale        kx0 = 128 * k        c = 65 + 95 * scale
;   x     = k*X - kx0           y   = c - k*Y

make "p17m0.k   0
make "p17m0.kx0 0
make "p17m0.c   0

to p17m0.setscale :range :table
  local "s
  make "s (item (:range + 1) :table) / 128
  make "p17m0.k :s * 1.25
  make "p17m0.kx0 128 * :p17m0.k
  make "p17m0.c 65 + (95 * :s)
end

;==========================================================================
; The scene data
;
; Every shape is stored two ways: FLAT (`y x y x ...`, one list, what the
; real vector lists will look like), and as two PARALLEL lists `ys`/`xs`
; (what candidate 3's `foreach` wants). The flat form is the one written
; by hand or generated; the parallel form is split out of it once, at
; load time, so nothing timed below pays for the split.

; `item`, not the walk this file is measuring: these run once a shape, at
; load time, well outside anything timed below.
to p17m0.ys.of :flat
  local "out local "n
  make "out []
  make "n (count :flat) / 2
  repeat :n [make "out lput (item ((2 * repcount) - 1) :flat) :out]
  output :out
end

to p17m0.xs.of :flat
  local "out local "n
  make "out []
  make "n (count :flat) / 2
  repeat :n [make "out lput (item (2 * repcount) :flat) :out]
  output :out
end

; The left wall -- VARC.ASM:LWALL, section 6.2's own transcription. The
; right wall is the same four points mirrored in x about the centroid
; (x' = 256 - x); a straight corridor's two side walls are the same
; shape either way round.
make "p17m0.lwall.flat [16 27 38 64 114 64 136 27]
make "p17m0.rwall.flat [16 229 38 192 114 192 136 229]

; A placeholder ceiling line -- VERT.ASM's real one is one of the ~50
; points in section 11.1's table, not yet transcribed.
make "p17m0.ceil.flat [16 0 16 255]

; Two small peek-a-boo marks, mirrored the same way as the walls.
make "p17m0.peekl.flat [70 10 66 22 74 22 70 34]
make "p17m0.peekr.flat [70 246 66 234 74 234 70 222]

; Three floor objects, sized to section 11.1's VOBJ average of ~40/6,
; spread across the cell so they do not overlap.
make "p17m0.obj1.flat [130 40 140 46 148 40 148 30 140 24 132 30 130 40]
make "p17m0.obj2.flat [128 120 138 126 146 120 146 110 138 104 130 110 128 120]
make "p17m0.obj3.flat [126 200 136 206 144 200 144 190 136 184 128 190 126 200]

; The creature: 55 points, generated rather than typed, so the POINT
; COUNT matches section 11.1's average even though the shape is a
; deterministic zigzag and not a spider. Y stays inside the viewer's
; 0-151 band; X spreads either side of the centroid, 128.
to p17m0.gen.ys :n
  local "out
  make "out []
  repeat :n [make "out lput (40 + modulo (repcount * 13) 100) :out]
  output :out
end

to p17m0.gen.xs :n
  local "out
  make "out []
  repeat :n [make "out lput (70 + modulo (repcount * 29) 120) :out]
  output :out
end

to p17m0.flatten :ys :xs
  local "out local "n
  make "out []
  make "n count :ys
  repeat :n [
    make "out lput (item repcount :ys) :out
    make "out lput (item repcount :xs) :out
  ]
  output :out
end

make "p17m0.creature.ys p17m0.gen.ys 55
make "p17m0.creature.xs p17m0.gen.xs 55
make "p17m0.creature.flat p17m0.flatten :p17m0.creature.ys :p17m0.creature.xs

; The parallel form of every hand-written shape, split from the flat one.
make "p17m0.lwall.ys  p17m0.ys.of :p17m0.lwall.flat
make "p17m0.lwall.xs  p17m0.xs.of :p17m0.lwall.flat
make "p17m0.rwall.ys  p17m0.ys.of :p17m0.rwall.flat
make "p17m0.rwall.xs  p17m0.xs.of :p17m0.rwall.flat
make "p17m0.ceil.ys   p17m0.ys.of :p17m0.ceil.flat
make "p17m0.ceil.xs   p17m0.xs.of :p17m0.ceil.flat
make "p17m0.peekl.ys  p17m0.ys.of :p17m0.peekl.flat
make "p17m0.peekl.xs  p17m0.xs.of :p17m0.peekl.flat
make "p17m0.peekr.ys  p17m0.ys.of :p17m0.peekr.flat
make "p17m0.peekr.xs  p17m0.xs.of :p17m0.peekr.flat
make "p17m0.obj1.ys   p17m0.ys.of :p17m0.obj1.flat
make "p17m0.obj1.xs   p17m0.xs.of :p17m0.obj1.flat
make "p17m0.obj2.ys   p17m0.ys.of :p17m0.obj2.flat
make "p17m0.obj2.xs   p17m0.xs.of :p17m0.obj2.flat
make "p17m0.obj3.ys   p17m0.ys.of :p17m0.obj3.flat
make "p17m0.obj3.xs   p17m0.xs.of :p17m0.obj3.flat

;==========================================================================
; Q1 -- the three list walks, section 6.3
;
; All three take the SAME shape and must draw the SAME picture; only the
; walk differs. `test_p17m0.c` pins that they agree before this file's
; timings are allowed to mean anything -- a "fastest" candidate that
; draws nothing is not a result.

; Candidate 1: `item` with a running index, over the FLAT list. Two
; `item` calls a point (Y then X), exactly section 6.3's "120 item calls"
; for a 60-point creature.
to p17m0.walk.item :flat
  local "pts local "i
  make "pts (count :flat) / 2
  make "i 1
  pu (setpos ((:p17m0.k * item 2 :flat) - :p17m0.kx0)
             (:p17m0.c - (:p17m0.k * item 1 :flat))) pd
  repeat :pts - 1 [
    make "i :i + 1
    (setpos ((:p17m0.k * item (2 * :i) :flat) - :p17m0.kx0)
            (:p17m0.c - (:p17m0.k * item ((2 * :i) - 1) :flat)))
  ]
  pu
end

; Candidate 2: `first`/`butfirst` down the FLAT list. `prim_butfirst`
; (core/primitives_words_lists.c) hands back the next cons cell directly
; -- `mem_next_cell(list)`, no allocation -- so this candidate is linear
; and, if section 6.3's open question resolves the way the source reads,
; costs nothing in `nodes` or `atoms` either.
to p17m0.walk.bf :flat
  local "rest local "yy local "xx
  make "rest :flat
  make "yy first :rest  make "rest bf :rest
  make "xx first :rest  make "rest bf :rest
  pu (setpos ((:p17m0.k * :xx) - :p17m0.kx0)
             (:p17m0.c - (:p17m0.k * :yy))) pd
  while [not empty? :rest] [
    make "yy first :rest  make "rest bf :rest
    make "xx first :rest  make "rest bf :rest
    (setpos ((:p17m0.k * :xx) - :p17m0.kx0)
            (:p17m0.c - (:p17m0.k * :yy)))
  ]
  pu
end

; Candidate 3: `foreach` over the PARALLEL `ys`/`xs` lists -- "one list
; per polyline" read as one list of each coordinate, which is what the
; two-data-list form of `foreach` is for. The first point is drawn by
; hand so the pen-up/pen-down bracket is right; `foreach` then walks the
; rest, one lambda call a point.
to p17m0.walk.foreach :ys :xs
  pu (setpos ((:p17m0.k * item 1 :xs) - :p17m0.kx0)
             (:p17m0.c - (:p17m0.k * item 1 :ys))) pd
  (foreach (bf :ys) (bf :xs) [[y x]
    (setpos ((:p17m0.k * :x) - :p17m0.kx0) (:p17m0.c - (:p17m0.k * :y)))
  ])
  pu
end

; One call site for the cell walk below, so the three candidates cannot
; drift into three different pictures.
to p17m0.draw.shape :which :flat :ys :xs
  if :which = "item [p17m0.walk.item :flat  stop]
  if :which = "bf [p17m0.walk.bf :flat  stop]
  p17m0.walk.foreach :ys :xs
end

;==========================================================================
; The cell walk -- section 6, the VIEWER pseudocode reduced to ten
; ranges of a corridor. Every range draws its two side walls and its
; ceiling line (the corridor never opens into a room here, on purpose --
; a passage the whole nine ranges is what stops VIEW60 from cutting the
; walk short, and short is the opposite of worst case). The near cell
; additionally carries the creature, both peeks, and the three objects.

to p17m0.status
  pu (setpos -150 -55) pd
  setpc 254
  write [IRON SWORD LEATHER SHIELD SOLAR TORCH]
end

to p17m0.redraw :which :table
  local "r
  clean
  repeat 10 [
    make "r repcount - 1
    p17m0.setscale :r :table
    p17m0.draw.shape :which :p17m0.lwall.flat :p17m0.lwall.ys :p17m0.lwall.xs
    p17m0.draw.shape :which :p17m0.rwall.flat :p17m0.rwall.ys :p17m0.rwall.xs
    p17m0.draw.shape :which :p17m0.ceil.flat :p17m0.ceil.ys :p17m0.ceil.xs
    if :r = :p17m0.near [
      p17m0.draw.shape :which :p17m0.creature.flat :p17m0.creature.ys :p17m0.creature.xs
      p17m0.draw.shape :which :p17m0.peekl.flat :p17m0.peekl.ys :p17m0.peekl.xs
      p17m0.draw.shape :which :p17m0.peekr.flat :p17m0.peekr.ys :p17m0.peekr.xs
      p17m0.draw.shape :which :p17m0.obj1.flat :p17m0.obj1.ys :p17m0.obj1.xs
      p17m0.draw.shape :which :p17m0.obj2.flat :p17m0.obj2.ys :p17m0.obj2.xs
      p17m0.draw.shape :which :p17m0.obj3.flat :p17m0.obj3.ys :p17m0.obj3.xs
    ]
  ]
  p17m0.status
end

;==========================================================================
; Q2 -- the fade, section 8 and 8.1, drawn both ways for a photograph.
; `setpendash (VCTFAD + 1)` is P18 M2, verbatim; the grey column reads
; the same table as luminance through eight `setpalette` entries in the
; 240-247 range (254 and 255 are reserved -- text foreground and the
; picture background).

make "p17m0.dash [1 2 3 5 9 17 33 65]
make "p17m0.grey [255 128 85 51 28 15 8 4]

to p17m0.fade.demo
  local "x
  cs fullscreen ht
  repeat 8 [
    setpendash item repcount :p17m0.dash
    make "x -154 + ((repcount - 1) * 38)
    pu (setpos :x 40) pd (setpos :x 140)
  ]
  setpendash 1
  repeat 8 [
    setpalette (239 + repcount) (list item repcount :p17m0.grey
                                       item repcount :p17m0.grey
                                       item repcount :p17m0.grey)
    setpc (239 + repcount)
    make "x -154 + ((repcount - 1) * 38)
    pu (setpos :x -40) pd (setpos :x -140)
  ]
  setpc 254
end

;==========================================================================
; Q3 -- the 1.25x check, section 6.2's own hand-worked numbers at range 1.

to p17m0.check :got :want :label
  ifelse 0.05 > abs (:got - :want) [
    pr (se [  OK] :label :got)
  ] [
    pr (se [  FAIL] :label :got [expected] :want)
  ]
end

to p17m0.q3
  p17m0.setscale 1 :p17m0.norscl
  pr [Q3 -- the 1.25x check, range 1]
  p17m0.check :p17m0.k 1.25 [k]
  p17m0.check :p17m0.kx0 160 [kx0]
  p17m0.check :p17m0.c 160 [c]
  p17m0.check ((:p17m0.k * 0) - :p17m0.kx0) -160 [x at X=0]
  p17m0.check ((:p17m0.k * 255) - :p17m0.kx0) 158.75 [x at X=255]
  p17m0.check (:p17m0.c - (:p17m0.k * 0)) 160 [y at Y=0]
  p17m0.check (:p17m0.c - (:p17m0.k * 151)) -28.75 [y at Y=151]
  p17m0.check ((:p17m0.k * 128) - :p17m0.kx0) 0 [centroid x]
  p17m0.check (:p17m0.c - (:p17m0.k * 76)) 65 [centroid y]
end

;==========================================================================
; Q4 -- the clock. Same pattern as P13 M0: asked for, not assumed, and a
; refusal (or a host with no such capability) leaves the run at whatever
; it already had.

to p17m0.read.cpu
  local "f
  make "f "unknown
  catch "error [make "f hw.cpu]
  output :f
end

to p17m0.read.temp
  local "t
  make "t 0
  catch "error [make "t hw.temperature]
  output :t
end

;==========================================================================
; Q1's timings -- one shape (the creature, 55 points), 1,000 walks warm.
;
; The first 1,000 are a warm-up and are not timed: a cold `nodes`/`atoms`
; reading charges the first pass for interning every number the shape's
; coordinates need, and that looks exactly like a leak. The SECOND 1,000
; are timed, and `nodes`/`atoms` either side of THOSE are what answers
; "does it allocate."

make "p17m0.n0 0  make "p17m0.n1 0
make "p17m0.a0 0  make "p17m0.a1 0

to p17m0.time.walk :which
  local "t0 local "elapsed
  repeat 1000 [
    p17m0.draw.shape :which :p17m0.creature.flat
                            :p17m0.creature.ys :p17m0.creature.xs
  ]
  make "p17m0.n0 nodes  make "p17m0.a0 atoms
  make "t0 ticks
  repeat 1000 [
    p17m0.draw.shape :which :p17m0.creature.flat
                            :p17m0.creature.ys :p17m0.creature.xs
  ]
  make "elapsed ticks - :t0
  make "p17m0.n1 nodes  make "p17m0.a1 atoms
  output :elapsed / 1000
end

;==========================================================================
; The full redraw and the present, timed per candidate.

to p17m0.time.redraw :which :table :reps
  local "t0
  make "t0 ticks
  repeat :reps [p17m0.redraw :which :table]
  output (ticks - :t0) / :reps
end

to p17m0.time.present
  local "t0 local "total
  make "total 0
  repeat 20 [
    p17m0.redraw "bf :p17m0.norscl
    make "t0 ticks
    refresh
    make "total :total + (ticks - :t0)
  ]
  output :total / 20
end

to p17m0.time.status
  local "t0
  make "t0 ticks
  repeat 200 [p17m0.status]
  output (ticks - :t0) / 200
end

;==========================================================================
; The report

to p17m0.report
  pr [P17 M0 -- the harness, and the three questions]
  pr []
  ifelse "unknown = :p17m0.cpu0 [
    pr [the clock could not be read -- figures are at whatever it was]
  ] [
    pr (se [processor at start] :p17m0.cpu0
        [-- normal is 150 MHz, fast is 300])
  ]
  pr (se [die temperature] :p17m0.temp0 [C before,] :p17m0.temp1 [C after])
  pr []

  pr [Q1 -- the three list walks, one 55-point shape, 1000 walks warm]
  pr (se [  item, running index] :p17m0.time.item [ms each])
  pr (se [    nodes] :p17m0.dn.item [atoms] :p17m0.da.item
      [-- 0 either side means no allocation])
  pr (se [  first / butfirst] :p17m0.time.bf [ms each])
  pr (se [    nodes] :p17m0.dn.bf [atoms] :p17m0.da.bf)
  pr (se [  foreach, two lists] :p17m0.time.foreach [ms each])
  pr (se [    nodes] :p17m0.dn.foreach [atoms] :p17m0.da.foreach)
  pr []

  pr [Q2 -- the fade. Drawn on screen: dots on top, grey below.]
  pr [  Gate is a photograph against a real CoCo -- read by eye.]
  pr []

  p17m0.q3
  pr []

  pr [Q4 -- did this board take hw.setcpu "fast]
  pr (se [  at start] :p17m0.cpu0 [-- switch] :p17m0.switched
      [-- now] :p17m0.cpu1)
  pr []

  pr [the worst-case scene: a nine-deep corridor, a creature near,]
  pr [two peeks, three floor objects -- section 12's worst case]
  pr (se [  points drawn] :p17m0.points [against the design's ~110])
  pr []
  pr (se [  redraw, item walk   ] :p17m0.redraw.item [ms])
  pr (se [  redraw, bf walk     ] :p17m0.redraw.bf [ms])
  pr (se [  redraw, foreach walk] :p17m0.redraw.foreach [ms])
  pr (se [  present, split mode ] :p17m0.present [ms, design predicts 19.8/18.7])
  pr (se [  status line, one write] :p17m0.status.ms [ms])
  pr []
  ifelse "true = :p17m0.switched [
    pr (se [  redraw at fast, bf walk] :p17m0.redraw.bf.fast [ms])
    pr (se [  MOVE at fast (half + step)] :p17m0.move.fast [ms])
  ] [
    pr [  fast clock unavailable here -- no fast-clock figures]
  ]
  pr (se [  MOVE, normal clock (half + step)] :p17m0.move.normal [ms])
  pr []

  pr [the gate, section 12: worst-case redraw under 100 ms at 300 MHz,]
  pr [with the 150 MHz figure taken alongside it]
  ifelse "true = :p17m0.switched [
    ifelse 100 > :p17m0.redraw.bf.fast [
      pr [  PASS at 300 MHz]
    ] [
      pr [  FAIL at 300 MHz -- section 6.3's levers: a display-list]
      pr [  primitive, or arrays (P18 M3)]
    ]
  ] [
    pr [  cannot check -- this run never reached 300 MHz]
  ]
  pr []
  pr (se [nodes at start] :p17m0.node0 [at end] :p17m0.node1)
  pr (se [word bytes free] :p17m0.atom0 [at start,] :p17m0.atom1 [at end])
  pr []
end

to p17m0
  local "n0 local "n1 local "w0 local "w1
  recycle
  make "n0 nodes  make "w0 atoms

  splitscreen
  window
  setrefresh "manual
  clean

  make "p17m0.cpu0 p17m0.read.cpu
  make "p17m0.temp0 p17m0.read.temp

  ; Q1
  make "p17m0.time.item p17m0.time.walk "item
  make "p17m0.dn.item :p17m0.n1 - :p17m0.n0
  make "p17m0.da.item :p17m0.a1 - :p17m0.a0

  make "p17m0.time.bf p17m0.time.walk "bf
  make "p17m0.dn.bf :p17m0.n1 - :p17m0.n0
  make "p17m0.da.bf :p17m0.a1 - :p17m0.a0

  make "p17m0.time.foreach p17m0.time.walk "foreach
  make "p17m0.dn.foreach :p17m0.n1 - :p17m0.n0
  make "p17m0.da.foreach :p17m0.a1 - :p17m0.a0

  ; the point count actually drawn, read back by counting rather than
  ; assumed -- ten ranges of three shapes, plus six near-cell shapes
  make "p17m0.points ((10 * ((count :p17m0.lwall.flat) / 2)) +
                       (10 * ((count :p17m0.rwall.flat) / 2)) +
                       (10 * ((count :p17m0.ceil.flat) / 2)) +
                       ((count :p17m0.creature.flat) / 2) +
                       ((count :p17m0.peekl.flat) / 2) +
                       ((count :p17m0.peekr.flat) / 2) +
                       ((count :p17m0.obj1.flat) / 2) +
                       ((count :p17m0.obj2.flat) / 2) +
                       ((count :p17m0.obj3.flat) / 2))

  ; the worst-case scene, each candidate, at whatever clock we started at
  make "p17m0.redraw.item p17m0.time.redraw "item :p17m0.norscl 200
  make "p17m0.redraw.bf p17m0.time.redraw "bf :p17m0.norscl 200
  make "p17m0.redraw.foreach p17m0.time.redraw "foreach :p17m0.norscl 200
  make "p17m0.present p17m0.time.present
  make "p17m0.status.ms p17m0.time.status
  make "p17m0.move.normal (p17m0.time.redraw "bf :p17m0.hlfscl 100) + (p17m0.time.redraw "bf :p17m0.norscl 100)

  ; Q4 -- try the fast clock; a refusal (or the host) just skips the
  ; fast-clock figures rather than stopping the run
  make "p17m0.switched "false
  catch "error [hw.setcpu "fast  make "p17m0.switched "true]
  make "p17m0.cpu1 p17m0.read.cpu
  ifelse "true = :p17m0.switched [
    make "p17m0.redraw.bf.fast p17m0.time.redraw "bf :p17m0.norscl 200
    make "p17m0.move.fast (p17m0.time.redraw "bf :p17m0.hlfscl 100) + (p17m0.time.redraw "bf :p17m0.norscl 100)
  ] [
    make "p17m0.redraw.bf.fast -1
    make "p17m0.move.fast -1
  ]

  make "p17m0.temp1 p17m0.read.temp

  ; Q2 -- last, because it leaves the fade on screen for the photograph
  p17m0.fade.demo
  wait 200

  ; restore the clock we found, so a board run does not leave the
  ; machine changed rather than merely measured on
  if not ("unknown = :p17m0.cpu0) [
    catch "error [hw.setcpu :p17m0.cpu0]
  ]

  make "n1 nodes  make "w1 atoms
  recycle
  make "p17m0.node0 :n0  make "p17m0.node1 :n1
  make "p17m0.atom0 :w0  make "p17m0.atom1 :w1

  setrefresh "auto
  textscreen
  open "p17m0.txt
  setwrite "p17m0.txt
  p17m0.report
  setwrite []
  close "p17m0.txt
  p17m0.report
  pr [Also written to p17m0.txt]
end
