;==========================================================================
; The cell -- CD.ASM: 00 passage, 01 door, 10 secret door, 11 wall, packed
; N E S W from the low bits up. `dagg.dir`/PDIR: 0=N 1=E 2=S 3=W.

; MAP32, DGNGEN.ASM: unconditionally wraps row/col mod 32 -- the forward
; view walks via STEP+MAP32 with no BORDER check at all (VIEWER.ASM never
; calls STEPOK), relying on a real maze always walling its true edges
; (Phase II). dagg.stepok is the separate, stricter check MOVE uses.
; Mazes are stored as levels of 32 rows of 32 cells (not flattened) --
; building one flat 1024-item list a level with `sentence`/`lput` in a
; loop is an O(n^2) copy and was enough to run a bounded heap out of
; space; two `item` lookups cost nothing this walk does not already pay.
to dagg.cell :level :row :col
  output (item ((modulo :col 32) + 1)
               (item ((modulo :row 32) + 1) (item (:level + 1) :dagg.mazes)))
end

to dagg.side :cell :dir
  output bitand (lshift :cell (0 - (:dir * 2))) 3
end

; STPTAB, CRETUR.ASM: N row-1, E col+1, S row+1, W col-1.
to dagg.step.row :row :dir
  if :dir = 0 [output :row - 1]
  if :dir = 2 [output :row + 1]
  output :row
end

to dagg.step.col :col :dir
  if :dir = 1 [output :col + 1]
  if :dir = 3 [output :col - 1]
  output :col
end

; STEPOK, CRETUR.ASM: off-maze (BORDER) or into a $FF (not part of the
; maze) cell is illegal. No wraparound -- a step that would need `mod 32`
; to land back in 0..31 is exactly what BORDER rejects.
to dagg.stepok :row :col
  if :row < 0 [output false]
  if :row > 31 [output false]
  if :col < 0 [output false]
  if :col > 31 [output false]
  output not (255 = dagg.cell :dagg.level :row :col)
end

;==========================================================================
; The transform -- design section 6.2, board-confirmed at M0
; (tests/logo/p17m0): three constants a range, two multiplies and two
; subtracts a point.

make "dagg.k   0
make "dagg.kx0 0
make "dagg.c   0

to dagg.setscale :range :table
  local "s
  make "s (item (:range + 1) :table) / 128
  make "dagg.k :s * 1.25
  make "dagg.kx0 128 * :dagg.k
  make "dagg.c 65 + (95 * :s)
end

; SETFAX, VCTLST.ASM (design section 8): outputs whether this range draws
; at all, and sets the dash period as a side effect when it does.
; `CMPA #-7 / BLE SFAD30` is total darkness at MINUS SEVEN, not past it.
to dagg.setfade :range
  local "a
  make "a (:dagg.light - 7) - :range
  if not (:a < 0) [setpendash 1  output true]
  if not (:a > -7) [output false]
  setpendash item ((0 - :a) + 1) :dagg.dash
  output true
end

;==========================================================================
; Drawing a vector list -- M0's winning candidate, `foreach` over the
; parallel ys/xs lists `dagg.load` already split out.

to dagg.draw.run :ys :xs
  pu (setpos ((:dagg.k * item 1 :xs) - :dagg.kx0)
             (:dagg.c - (:dagg.k * item 1 :ys))) pd
  (foreach (bf :ys) (bf :xs) [[y x]
    (setpos ((:dagg.k * :x) - :dagg.kx0) (:dagg.c - (:dagg.k * :y)))
  ])
  pu
end

to dagg.draw.runs :runs
  foreach :runs [[run] dagg.draw.run (item 1 :run) (item 2 :run)]
end

; FLATAB's dispatch, SWCHAR.ASM: which=l/f/r, code=0 passage/1 door/
; 2 secretdoor/3 wall, in the order the four lists were loaded.
to dagg.side.runs :which :code
  if :which = "l [output item (:code + 1) :dagg.left]
  if :which = "f [output item (:code + 1) :dagg.forward]
  output item (:code + 1) :dagg.right
end

; VIEW22's fallthrough: a secret door draws under its own list AND the
; plain wall underneath it (design section 8.3 -- regular light still
; shows a wall where a secret door is; only magic light shows the door).
to dagg.draw.side :which :code
  ifelse :code = 2 [
    dagg.draw.runs dagg.side.runs :which 2
    dagg.draw.runs dagg.side.runs :which 3
  ] [
    dagg.draw.runs dagg.side.runs :which :code
  ]
end

;==========================================================================
; The cell walk -- VIEWER.ASM:VIEWER/VIEW10-VIEW60, design section 6.

to dagg.redraw :table
  local "r local "row local "col local "cell
  local "lcode local "rcode local "fcode
  local "stop local "visible
  clean
  setpc :dagg.ink
  make "row :dagg.row
  make "col :dagg.col
  make "stop false
  repeat 10 [
    if not :stop [
      make "r repcount - 1
      dagg.setscale :r :table
      make "visible dagg.setfade :r
      make "cell dagg.cell :dagg.level :row :col
      make "lcode dagg.side :cell (modulo (:dagg.dir + 3) 4)
      make "rcode dagg.side :cell (modulo (:dagg.dir + 1) 4)
      make "fcode dagg.side :cell :dagg.dir
      if :visible [
        dagg.draw.side "l :lcode
        dagg.draw.side "f :fcode
        dagg.draw.side "r :rcode
        dagg.draw.runs :dagg.celine
      ]
      ifelse :fcode = 0 [
        make "row dagg.step.row :row :dagg.dir
        make "col dagg.step.col :col :dagg.dir
      ] [
        make "stop true
      ]
    ]
  ]
  dagg.status
end

;==========================================================================
; The status bar -- design section 4.1b/4.1c: it lives IN THE PICTURE, not
; the text window (the CoCo original has no text mode at all, and `clean`
; is what erases it) -- so this is `write`, not `setcursor`+`type` the way
; battlezone/berzerk's HUD works. Do not "fix" this back to `setcursor`.
;
; STATUX, STATUS.ASM: the left hand's object at column 0, the right hand's
; right-justified to the last column, the heart between them, and the whole
; row drawn in the OPPOSITE polarity to the view above it -- which is the
; three-argument `write` P18 M1 exists for. The CoCo justifies to columns 0
; and 31 of 32; ours is 0 and 39 of 40, design section 4.1's identity.
;
; It is one 40-character string and one `write`, not two writes of the two
; names, because STATUX inverts the whole status row and not just the cells
; a glyph lands in: the spaces between the hands are part of the bar.
;
; Nothing puts an object in a hand until M3, so both names are M$EMPT.

make "dagg.lhand "EMPTY
make "dagg.rhand "EMPTY

to dagg.spaces :n
  local "s
  make "s "
  repeat :n [make "s word :s char 32]
  output :s
end

to dagg.status.line
  output (word :dagg.lhand
               dagg.spaces (40 - ((count :dagg.lhand)
                                  + (count :dagg.rhand)))
               :dagg.rhand)
end

to dagg.status
  pu (setpos -160 -55)
  (write dagg.status.line :dagg.status.fg :dagg.status.bg)
end

;==========================================================================
; Inverted levels -- NEWLVL.ASM:NLVL50 / design section 4.3: internal
; level 0,2,4 (displayed 1,3,5) light-on-dark; internal 1,3 (displayed
; 2,4) dark-on-light, with the status bar always the OPPOSITE polarity to
; the view above it.

; White is 254, not 255: reference appendix E -- slot 255 HOLDS the current
; graphics background, so `setpc 255` paints in the background and draws a
; picture you cannot see, and `setbg 255` is outside setbg's own 0..254
; range and errors outright. B81.
to dagg.enter.level :level
  make "dagg.level :level
  ifelse (modulo :level 2) = 0 [
    make "dagg.ink 254  make "dagg.bg 0
    make "dagg.status.fg 0  make "dagg.status.bg 254
  ] [
    make "dagg.ink 0  make "dagg.bg 254
    make "dagg.status.fg 254  make "dagg.status.bg 0
  ]
  setbg :dagg.bg
  ; The heart is a turtle wearing an `fe` (own-pen-colour) costume, so its
  ; polarity is one `setpc` on turtle 1 -- NLVL50 flips it with the bar.
  ask 1 [setpc :dagg.status.fg]
end

;==========================================================================
; TURN -- PTURN.ASM. A sweeping vertical stroke, drawn then erased, at
; eight steps between two fixed bounds -- design section 6.4's "eight
; strokes." TURN00 manually sets the scale to 128/128 (1:1, range 1's own
; transform), so this reuses `dagg.setscale 1 :dagg.norscl` rather than
; inventing a second transform.
;
; CoCo-specific inverse-video toggling (`COM VDGINV` between strokes) is
; not reproduced pixel-for-pixel -- this draws each stroke, pauses, then
; erases it with `pe`, which is this codebase's own eraser (gen_rocks.py's
; own note: "`pe` still erases correctly"), not the ROM's polarity flip.
;
; TURN00 does FOUR things before the first stroke, and M1 did only the
; first: set the scale to 1:1, set range 0's fade, ERASE THE CURRENT SCREEN
; (`SWI ZFLIP`), and draw LINES -- two full-width horizontals at rows 16
; and 136. The sweep plays on THAT picture, not over the view, and the
; view for the new direction is built invisibly (PREVU/PUPSUB) and shown
; afterwards. Drawing the sweep over the finished view instead means every
; `pe` stroke gouges a full-height stripe out of it: long lines come back
; with holes in them and short ones -- the distant ones -- disappear
; outright.

; LINES, PTURN.ASM: rows 16 and 136, the full 256 across, in the ys/xs run
; form dagg.draw.run takes.
make "dagg.turnlines [[[16 16] [0 255]] [[136 136] [0 255]]]

to dagg.range8 :start :step
  local "out
  make "out []
  repeat 8 [make "out lput (:start + ((repcount - 1) * :step)) :out]
  output :out
end

; LRTU10 starts at 8 and adds 32 while the high byte is zero -- 8, 40, ...
; 232, eight strokes. RLTU10 starts at 248 and subtracts 32 while the
; result stays positive -- 248, 216, ... 24, also eight.
;
; `wait 13` is the one number in this file that is an estimate rather than
; a transcription: VECTOR's inner loop is roughly fifty 0.895 MHz cycles a
; point, a stroke is 118 points, and TURN10 draws it and then erases it, so
; the CoCo spends ~13 ms a stroke and ~105 ms on a sweep. It is the number
; to tune on a board if the whoosh reads too fast or too slow.
to dagg.turnsweep :dir
  local "y0 local "y1 local "positions
  dagg.setscale 1 :dagg.norscl
  ignore dagg.setfade 0
  clean
  setpc :dagg.ink
  dagg.draw.runs :dagg.turnlines
  make "y0 :dagg.c - (:dagg.k * 17)
  make "y1 :dagg.c - (:dagg.k * 135)
  ifelse :dir = "lr [
    make "positions dagg.range8 8 32
  ] [
    make "positions dagg.range8 248 -32
  ]
  foreach :positions [[cocox]
    local "x
    make "x (:dagg.k * :cocox) - :dagg.kx0
    pu (setpos :x :y0)
    pd (setpos :x :y1)
    refresh
    wait 13
    pe (setpos :x :y0)
    pu
  ]
end

; PTUR90 and PMOV90 both end `DEC UPDATE / SYNC` -- build the view for
; where the player now is and put it on the screen. It is the LAST thing
; a movement command does, after any animation, never before it.
to dagg.show
  dagg.redraw :dagg.norscl
  refresh
end

; PTURN parses its own second token off the line (design section 15's
; parser is M2's, and this is its first customer): DIRTAB row 1 LEFT,
; 2 RIGHT, 4 AROUND, and everything else -- including UP, DOWN, BACK and
; a missing token -- is ERRCMD2.
to dagg.turn
  local "n
  make "n dagg.parse dagg.gettok :dagg.dirtab
  if :n = 1 [
    make "dagg.dir modulo (:dagg.dir - 1) 4
    dagg.turnsweep "lr
    dagg.show
    stop
  ]
  if :n = 2 [
    make "dagg.dir modulo (:dagg.dir + 1) 4
    dagg.turnsweep "rl
    dagg.show
    stop
  ]
  if :n = 4 [
    make "dagg.dir modulo (:dagg.dir + 2) 4
    dagg.turnsweep "rl
    dagg.turnsweep "rl
    dagg.show
    stop
  ]
  dagg.cmderr
end

;==========================================================================
; MOVE -- PTURN.ASM:PMOVE/PSTEP. Forward/backward draw a half-step frame
; from the OLD cell before the position updates (PMOVE's own order: PUPDAT
; at HLFSCL, then PSTEP, then the normal redraw) -- section 6.4's "one
; intermediate frame before the step, then the step and the real frame."
;
; A blocked step (into a wall or off the maze) still redraws from the
; unchanged position -- PSTEP always calls PUPSUB -- but does not yet
; charge the weight/8+3 energy cost or play A$THUD: PDAM/HUPDAT is M2/M3's
; job (the heart, damage and recovery are explicitly M2's line item, design
; section 15), and inventing a placeholder damage system here would be
; scope this milestone does not own.

to dagg.move.forward
  local "nrow local "ncol local "ok
  make "nrow dagg.step.row :dagg.row :dagg.dir
  make "ncol dagg.step.col :dagg.col :dagg.dir
  make "ok dagg.stepok :nrow :ncol
  dagg.redraw :dagg.hlfscl
  refresh
  if :ok [make "dagg.row :nrow  make "dagg.col :ncol]
  dagg.show
end

to dagg.move.backward
  local "dir local "nrow local "ncol local "ok
  make "dir modulo (:dagg.dir + 2) 4
  make "nrow dagg.step.row :dagg.row :dir
  make "ncol dagg.step.col :dagg.col :dir
  make "ok dagg.stepok :nrow :ncol
  dagg.redraw :dagg.bakscl
  refresh
  if :ok [make "dagg.row :nrow  make "dagg.col :ncol]
  dagg.show
end

; Sidestep: PMOV30/40 -- step, redraw, and only on SUCCESS play the
; turn-style sweep (right step sweeps right-to-left, left step sweeps
; left-to-right -- PTURN.ASM's own RLTURN/LRTURN choices).
to dagg.move.side :reldir
  local "dir local "nrow local "ncol local "ok
  make "dir modulo (:dagg.dir + :reldir) 4
  make "nrow dagg.step.row :dagg.row :dir
  make "ncol dagg.step.col :dagg.col :dir
  make "ok dagg.stepok :nrow :ncol
  if :ok [make "dagg.row :nrow  make "dagg.col :ncol]
  if :ok [
    ifelse :reldir = 1 [dagg.turnsweep "rl] [dagg.turnsweep "lr]
  ]
  dagg.show
end

; PMOVE, PTURN.ASM. A missing direction is forward (PARSER outputs 0 and
; PMOVE's BLT/BGT both fall through), DIRTAB row 3 BACK is a step back,
; rows 1 and 2 sidestep, and AROUND/UP/DOWN are ERRCMD2.
;
; PMOV90 charges the energy on every accepted MOVE, blocked or not, and
; then calls HUPDAT -- so a corridor you cannot get out of still kills you.
to dagg.move
  local "n
  make "n dagg.parse dagg.gettok :dagg.dirtab
  if :n = 0 [dagg.move.forward  dagg.move.cost  stop]
  if :n = 3 [dagg.move.backward  dagg.move.cost  stop]
  if :n = 2 [dagg.move.side 1  dagg.move.cost  stop]
  if :n = 1 [dagg.move.side 3  dagg.move.cost  stop]
  dagg.cmderr
end

; PMOV90: (weight / 8) + 3, accumulated as damage. POBJWT starts at 35
; (COMDAT.ASM's `FDB 30+5`) and only GET/DROP move it, so until M3 the
; step costs a flat 7.
to dagg.move.cost
  make "dagg.pdam :dagg.pdam + (int (:dagg.objwt / 8)) + 3
  dagg.hupdat
end

;==========================================================================
; The player -- COMDAT.ASM's ONCE-only init block and ONCE.ASM:GAME10.
;
; PPOW is stored there as `FCB $17,160` and GAME10's `CLR PPOW` clears the
; high byte before a real game, so the player starts at 160 power. POBJWT
; is `FDB 30+5`.

make "dagg.ppow 160
make "dagg.pdam 0
make "dagg.objwt 35
make "dagg.heartr 46
make "dagg.faint "false
make "dagg.olight 8
make "dagg.hearts "false
make "dagg.heartf "true
make "dagg.over "false

;==========================================================================
; The heart -- design section 4.1a: turtle 1 wearing one of two costumes,
; because the compositor draws turtles OVER the picture and the redraw's
; `clean` therefore never has to repair it. It is the fastest-moving thing
; in the game (twenty times a second at the faint threshold) and it must
; cost nothing.
;
; The two glyph pairs are SWCHAR.ASM:SPCTAB's small and large hearts,
; I.SHL/I.SHR and I.LHL/I.LHR, transcribed as one 16-bit row mask a scan
; line -- the CoCo draws each as two 8-pixel character cells side by side,
; which is 16 pixels, and our own status cell is 8 wide by 10 tall, so the
; pair lands on exactly two cells here too. Eight rows because that is
; putsh's minimum dimension (the ROM's glyph is seven).
;
;        small                     large
;   ................    0   ................       0
;   ........#.#.....  160   .......##.##....     432
;   .......#####....  496   ......#######...    1016
;   .......#####....  496   ......#######...    1016
;   ........###.....  224   .......#####....     496
;   .........#......   64   ........###.....     224
;   ................    0   .........#......      64
;   ................    0   ................       0

make "dagg.heart.small [0 160 496 496 224 64 0 0]
make "dagg.heart.large [0 432 1016 1016 496 224 64 0]

; `fe` is "the wearing turtle's own pen colour" and `ff` is transparent, so
; one pair of costumes serves both polarities of design section 4.3 -- the
; level flip is a `setpc` on turtle 1, not a second pair of shapes.
to dagg.shrow :mask
  local "s
  make "s item (1 + bitand (lshift :mask -15) 1) [ff fe]
  repeat 15 [
    make "s word :s
      item (1 + bitand (lshift :mask (repcount - 15)) 1) [ff fe]
  ]
  output :s
end

to dagg.putheart :slot :rows
  local "out
  make "out []
  foreach :rows [[m] make "out lput dagg.shrow :m :out]
  putsh :slot :out
end

; Centred between the two hand names, on the same character row the status
; line is written to: turtle x 0 is device column 160, which is columns 19
; and 20 of the forty.
to dagg.setup.heart
  dagg.putheart 1 :dagg.heart.small
  dagg.putheart 2 :dagg.heart.large
  make "dagg.hearts "false
  make "dagg.heartf "true
  ask 1 [
    setrot "fixed
    pu (setpos 0 -55)
    setpc :dagg.status.fg
    setsh 1
    st
  ]
end

; CLK30, COMMON.ASM: count HEARTC down a jiffy at a time and, at zero,
; reload it from HEARTR and toggle the glyph. Scheduling the next beat is
; the same thing without the countdown, and it is what section 5 asks for.
;
; `COM HEARTS` toggles rather than cycling small-large-small, so the drawn
; period is two beats. HEARTF is cleared while a scroll puts the map up
; (PUSE.ASM:USC210) -- the beat carries on, the picture of it stops.
;
; The thump itself is M6 (design section 9.4): voices 0 and 4 are reserved
; for it so nothing can flush it.
to dagg.beat
  make "dagg.heart.due :dagg.now + (:dagg.heartr * 16.667)
  make "dagg.hearts not :dagg.hearts
  if :dagg.heartf [
    ifelse :dagg.hearts [ask 1 [setsh 2]] [ask 1 [setsh 1]]
    refresh
  ]
end

;==========================================================================
; HUPDAT -- HUPDAT.ASM:HUPDAX, the heart rate, fainting, waking and death.
;
; The comment in the ROM reads J = (P * 64) / (P + 2D) - 19, and the code
; does NOT compute that. HUPD20 divides by repeated subtraction and bumps
; the count BEFORE testing for the borrow, so the subtraction that goes
; negative is counted too: J = floor(64P / (P + 2D)) + 1 - 19. At the start
; (P 160, D 0) that is 46 jiffies -- 766 ms, 78 beats a minute -- where
; design section 9.4's paraphrase of the ROM's own comment says 45, 750 ms
; and 80. The ROM is the authority (design section 1), so this is 46.
to dagg.hupdat
  make "dagg.heartr ((int ((64 * :dagg.ppow)
                           / (:dagg.ppow + (2 * :dagg.pdam)))) + 1) - 19
  ifelse :dagg.faint [
    if :dagg.heartr > 4 [dagg.faint.up]
  ] [
    if not (:dagg.heartr > 3) [dagg.faint.down]
  ]
  if :dagg.pdam > :dagg.ppow [dagg.death]
end

; HUPD30: the light is walked down one step at a time with a full redraw at
; each until the screen is black, then the keyboard buffer is thrown away.
; The beat keeps time through it -- that is what the CoCo's IRQ did for
; free while the game task blocked, and it is why `dagg.heart.tick` is
; separate from `dagg.tick` (design section 9.4).
to dagg.faint.down
  ct
  make "dagg.olight :dagg.light
  until [:dagg.light < -7] [
    make "dagg.light :dagg.light - 1
    dagg.redraw :dagg.norscl
    refresh
    dagg.heart.tick
  ]
  clean
  refresh
  make "dagg.faint "true
  until [not key?] [ignore rc]
end

; HUPD42, and it walks back one step FURTHER than it walked down: the ROM
; increments and then tests `CMPA OLIGHT / BLE`, so it leaves at OLIGHT + 1.
; That is the ROM's arithmetic, not a transcription slip.
to dagg.faint.up
  until [:dagg.light > :dagg.olight] [
    dagg.redraw :dagg.norscl
    refresh
    dagg.heart.tick
    make "dagg.light :dagg.light + 1
  ]
  make "dagg.faint "false
  dagg.prompt
end

; DEATH: the wizard fades in, the status line goes, and the ROM sits in
; `BRA *` until a keystroke restarts the game. WIZ1's vector list is M4's
; creature data, so what M2 owns is the bar going, the message arriving,
; and the loop ending.
to dagg.death
  make "dagg.over "true
  make "dagg.heartf "false
  ask 1 [ht]
  pr []
  type char 32
  pr [YET ANOTHER DOES NOT RETURN...]
end

;==========================================================================
; The scheduler -- design section 5. The ROM's CLOCK IRQ drives five queues
; and a ready list; ours is one pass over the timers that exist, each a
; global holding the `ticks` value it is next due at. `ticks` is
; milliseconds and monotonic; a jiffy is 16.667 ms.
;
; Only two timers exist at M2. LUKNEW (twice a second) has nothing to do
; until a creature or a burning torch sets NEWLUK, and BURNER (once a
; minute) needs a torch, so both arrive with their own milestones rather
; than as empty procedures here.
;
; `dagg.heart.tick` is deliberately separate: it is the IRQ's half of the
; work, the half a long blocking effect has to keep calling.

make "dagg.now 0
make "dagg.heart.due 0
make "dagg.hslow.due 0

to dagg.heart.tick
  make "dagg.now ticks
  if not (:dagg.now < :dagg.heart.due) [dagg.beat]
end

to dagg.tick
  dagg.heart.tick
  if not (:dagg.now < :dagg.hslow.due) [dagg.hslow]
end

; HSLOW, COMPLR.ASM: recover a 64th of the damage and reschedule HEARTR
; jiffies out, so recovery runs at the heart's own rate and is slowest
; exactly when you are most hurt. ASRD6 shifts a NEGATED damage right six
; places, which floors a negative number, so the ROM recovers
; ceil(damage / 64) -- one point of damage still heals. The reschedule
; reads HEARTR after HUPDAT, not before.
to dagg.hslow
  make "dagg.pdam :dagg.pdam - (int ((:dagg.pdam + 63) / 64))
  if :dagg.pdam < 0 [make "dagg.pdam 0]
  dagg.hupdat
  make "dagg.hslow.due ticks + (:dagg.heartr * 16.667)
end

;==========================================================================
; The parser -- PARSER.ASM and TOKEN.ASM.
;
; A token matches a table entry when it is a PREFIX of that entry's word
; (PARS12 stops comparing when the token runs out), and two matches are an
; error rather than a preference (PARS20's `TST PARFLG / BNE PARS90`). So
; M is MOVE and Z is neither ZLOAD nor ZSAVE. The four-letter names in
; DTABAS.ASM's CMDXXX macro -- ATTK, INCN, REVE -- are assembler symbols
; and are NOT what the parser matches: CMDTAB holds the full words, and
; ATTK is not a prefix of ATTACK.
;
; FULFLG is set when the token is the whole word, which is what INCANT
; needs (M3) and nothing else looks at.

make "dagg.fulflg "false

to dagg.prefix? :tok :cmd
  if (count :tok) > (count :cmd) [output "false]
  repeat count :tok [
    if not ((item repcount :tok) = (item repcount :cmd)) [output "false]
  ]
  output "true
end

; PARSER's own three answers: 0 for a null token (PARS92 stores D = 0),
; -1 for no match or two matches (PARS90 stores NEGONE), otherwise the
; entry's 1-based row. Callers test `BLE` where a null token is illegal and
; `BLT` where it is not, which is exactly `:n < 1` against `:n < 0`.
to dagg.parse :tok :table
  local "hit local "cmd
  make "dagg.fulflg "false
  if empty? :tok [output 0]
  make "hit 0
  repeat count :table [
    make "cmd first item repcount :table
    if dagg.prefix? :tok :cmd [
      if :hit > 0 [make "dagg.fulflg "false  output -1]
      make "hit repcount
      if (count :tok) = (count :cmd) [make "dagg.fulflg "true]
    ]
  ]
  if :hit = 0 [output -1]
  output :hit
end

; CMDTAB and DISPAT, TOKEN.ASM/DTABAS.ASM, in the ROM's own order and
; paired with the instruction that runs each -- design section 14's third
; rule, one `run` over a table row rather than fifteen procedures.
; It arrives in seven statements because `load` runs a file a LINE at a
; time, so a list literal that spans lines is not a thing this dialect can
; be given; seven `se`s that run once at load read better than one
; 320-character line.
make "dagg.cmdtab [[ATTACK [dagg.soon]] [CLIMB [dagg.soon]] [DROP [dagg.soon]]]
make "dagg.cmdtab se :dagg.cmdtab [[EXAMINE [dagg.soon]] [GET [dagg.soon]]]
make "dagg.cmdtab se :dagg.cmdtab [[INCANT [dagg.soon]] [LOOK [dagg.soon]]]
make "dagg.cmdtab se :dagg.cmdtab [[MOVE [dagg.move]] [PULL [dagg.soon]]]
make "dagg.cmdtab se :dagg.cmdtab [[REVEAL [dagg.soon]] [STOW [dagg.soon]]]
make "dagg.cmdtab se :dagg.cmdtab [[TURN [dagg.turn]] [USE [dagg.soon]]]
make "dagg.cmdtab se :dagg.cmdtab [[ZLOAD [dagg.soon]] [ZSAVE [dagg.soon]]]

; DIRTAB. The string T.BAK labels is BACK, not BACKWARD -- the CoCo manual
; prints MOVE BACKWARD and the table does not hold it, so that spelling
; fails the prefix test and MOVE BACK, MOVE BA and MOVE B all pass it.
make "dagg.dirtab [[LEFT] [RIGHT] [BACK] [AROUND] [UP] [DOWN]]

;==========================================================================
; The line buffer and the tokens.
;
; LINBUF is 32 characters and HMAN20 falls into the carriage-return path
; when it fills, so a 32-character line submits itself. It is held here as
; a list of one-character words rather than as one growing word: a word
; interns, and a keystroke at a time would put every prefix of every line
; ever typed into the word table.

make "dagg.sp char 32
make "dagg.linbuf []
make "dagg.tokens []
make "dagg.linptr 1

; GETTOK, PARSER.ASM: leading spaces are eaten and runs of them separate,
; which is what splitting on non-empty runs does.
to dagg.split :chars
  local "out local "tok
  make "out []
  make "tok []
  foreach :chars [[c]
    ifelse :c = :dagg.sp [
      if not empty? :tok [make "out lput :tok :out  make "tok []]
    ] [
      make "tok lput :c :tok
    ]
  ]
  if not empty? :tok [make "out lput :tok :out]
  output :out
end

to dagg.gettok
  if :dagg.linptr > count :dagg.tokens [output []]
  make "dagg.linptr :dagg.linptr + 1
  output item (:dagg.linptr - 1) :dagg.tokens
end

;==========================================================================
; The text window -- design section 4.1c. The one thing that changes
; BETWEEN pictures rather than with them is the command line, so lines 24
; to 31 carry the messages and the prompt and nothing else. The status line
; is in the picture (see dagg.status) and does not live here.

; PROMPT, MISC.ASM: M$PROM1 is I.CR then I.DOT, and M$CURS draws an
; underline and backs over it. Our text window has a real cursor, so the
; prompt is the newline and the period.
to dagg.prompt
  pr []
  type char 46
end

; CMDERR, PARSER.ASM: two I.QUES, printed where the echoed line stopped,
; and the rest of the line thrown away (HMAN70 resets LINPTR).
to dagg.cmderr
  type word char 63 char 63
end

; The thirteen commands whose milestones are still ahead. Each row of
; dagg.cmdtab loses this as its own milestone lands; the table is complete
; from M2 because the PARSER's ambiguity rule depends on it -- Z has to be
; ambiguous and M has to not be.
to dagg.soon
  pr [NOT YET]
end

;==========================================================================
; HUMAN -- HUMAN.ASM:PLAY10/HUMAN. Echo the character, buffer it, handle
; backspace, and on carriage return parse and dispatch.

; PLAY10's ASCII-to-internal conversion: carriage return and backspace get
; their own codes, A-Z survive as themselves, and everything else becomes a
; space (the `CLRB` fallthrough). ESC is this port's one addition, because
; the ROM's death loop is `BRA *` and a Logo game has to let go.
to dagg.key :c
  local "a
  make "a ascii :c
  if :a = 27 [output "esc]
  if :a = 13 [output "cr]
  if :a = 10 [output "cr]
  if :a = 8 [output "bs]
  if :a = 127 [output "bs]
  make "c uppercase :c
  make "a ascii :c
  if and (:a > 64) (:a < 91) [output :c]
  output char 32
end

to dagg.human :c
  if :c = "esc [make "dagg.over "true  stop]
  if :dagg.faint [stop]
  if :c = "bs [
    if empty? :dagg.linbuf [stop]
    make "dagg.linbuf bl :dagg.linbuf
    type char 8
    stop
  ]
  if :c = "cr [dagg.enter  stop]
  type :c
  make "dagg.linbuf lput :c :dagg.linbuf
  if (count :dagg.linbuf) = 32 [dagg.enter]
end

; HMAN30/HMAN50/HMAN70: terminate the buffer, reset the pointer, dispatch
; on the first token, then prompt -- unless we are unconscious, in which
; case there is no prompt to give.
to dagg.enter
  make "dagg.tokens dagg.split :dagg.linbuf
  make "dagg.linbuf []
  make "dagg.linptr 1
  dagg.dispatch
  if :dagg.over [stop]
  if :dagg.faint [stop]
  dagg.prompt
end

to dagg.dispatch
  local "n
  make "n dagg.parse dagg.gettok :dagg.cmdtab
  if :n = 0 [stop]
  if :n < 0 [dagg.cmderr  stop]
  run item 2 (item :n :dagg.cmdtab)
end

;==========================================================================
; The game loop -- design section 5. Input is polled and never blocked on:
; `readchar` would stop the world and `pollkeys` discards the characters,
; and this is a typing game.

to dagg.play
  until [:dagg.over] [
    dagg.tick
    if key? [dagg.human dagg.key rc]
  ]
end

;==========================================================================
; `hw.setcpu "fast` + restore -- logo/games/battlezone's own pattern,
; reused verbatim (the mechanics are already solved in this tree; design
; section 12.1 names this file's `restore.clock` as the model).

to clock
  make "cpu.was "unknown
  catch "error [make "cpu.was hw.cpu]
  make "cpu.at :cpu.was
  catch "error [hw.setcpu "fast]
  catch "error [make "cpu.at hw.cpu]
  output "fast = :cpu.at
end

to restore.clock
  if "unknown = :cpu.was [stop]
  if :cpu.was = :cpu.at [stop]
  catch "error [hw.setcpu :cpu.was]
end

;==========================================================================
; Entry points. No `erall` here -- that is the operator's job before
; `load`, same convention as tests/logo/p17m0's own header.
;
; `daggorath` is GAME10 through GAME50: set the player where the ROM sets
; him, build the level, then fall into the scheduler. It returns when the
; player quits or dies, and puts the screen back the way it found it.

; ONCE.ASM:GAME10 -- `LDD #$100B / STD PROW` -- row 16, column 11, facing
; north, which is where docs/DungeonsOfDaggorath/Levels/level1.svg draws the
; player's blue dot. COMDAT.ASM's `FCB 12 / FCB 22` is the attract-mode
; DEMO's start; GAME10 overwrites it, and (12,22) is not a carved cell.
;
; GAME50 makes the initial view, fakes the prompt and falls into the
; scheduler, which is the last three statements here.
to daggorath
  make "dagg.row 16  make "dagg.col 11  make "dagg.dir 0
  make "dagg.ppow 160  make "dagg.pdam 0  make "dagg.objwt 35
  make "dagg.light 8  make "dagg.olight 8
  make "dagg.faint "false  make "dagg.over "false
  make "dagg.linbuf []  make "dagg.tokens []  make "dagg.linptr 1
  splitscreen
  window
  ct
  ht
  setrefresh "manual
  ignore clock
  dagg.enter.level 0
  dagg.setup.heart
  dagg.hupdat
  make "dagg.heart.due ticks
  make "dagg.hslow.due ticks + (:dagg.heartr * 16.667)
  dagg.redraw :dagg.norscl
  refresh
  dagg.prompt
  dagg.play
  daggorath.quit
end

to daggorath.quit
  restore.clock
  ask 1 [ht  setsh 0]
  setrefresh "auto
  setpendash 1
  setpc 254
  st
  textscreen
end
