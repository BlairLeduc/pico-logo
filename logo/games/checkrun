  setpalette :cr.rock.c [214 122 40]
  setpalette :cr.sand [198 161 100]
  setpalette :cr.panel.c [8 11 16]
  setpalette :cr.smoke.c [190 196 202]
  setpalette :cr.enemy.c [238 105 90]
  setpalette :cr.road.c [86 97 109]
  setpalette :cr.player.c [75 220 230]
  setpalette :cr.flag.c [246 210 70]
  setpalette :cr.turbo.c [224 70 190]
  setpalette :cr.text [232 237 242]
end

to select.world :n
  ifelse :n = 1 [select.world.1] [select.world.2]
end

to select.world.1
  make "cr.map :cr.map.1
  make "cr.start :wa.start
  make "cr.cand :wa.cand
  make "cr.garage :wa.garage
  make "rock.tile :wa.rocks
end

to select.world.2
  make "cr.map :cr.map.2
  make "cr.start :wb.start
  make "cr.cand :wb.cand
  make "cr.garage :wb.garage
  make "rock.tile :wb.rocks
end

to hex.value :h
  local "a
  make "a (ascii :h)
  if :a < 58 [output :a - 48]
  output :a - 55
end

to road.at :c :r
  local "row local "ch
  if :c < 0 [output 0]
  if :c > 31 [output 0]
  if :r < 0 [output 0]
  if :r > 39 [output 0]
  make "row (item (:r + 1) :cr.map)
  make "ch (item (:c + 1) :row)
  output hex.value :ch
end

to road? :c :r
  local "m
  make "m (road.at :c :r)
  output not (:m = 0)
end

to road.open? :c :r :d
  local "m local "b
  make "m (road.at :c :r)
  make "b (dir.bit :d)
  output not (0 = (bitand :m :b))
end

to exit.count :c :r
  local "m local "n local "b
  make "m (road.at :c :r)
  make "n 0
  repeat 4 [
    make "b (dir.bit (repcount - 1))
    if not (0 = (bitand :m :b)) [make "n (:n + 1)]
  ]
  output :n
end

; -------------------------------------------------------------------------
; Tiles, sectors, directions, coordinates.
; -------------------------------------------------------------------------

to tile.index :c :r
  output (:r * 32) + :c + 1
end

to tile.col :tile
  output remainder (:tile - 1) 32
end

to tile.row :tile
  output intquotient (:tile - 1) 32
end

to sector.of :c :r
  output ((intquotient :r 20) * 2) + (intquotient :c 16)
end

to sector.col :c
  output remainder :c 16
end

to sector.row :r
  output remainder :r 20
end

to sector.base.col :s
  output (remainder :s 2) * 16
end

to sector.base.row :s
  output (intquotient :s 2) * 20
end

to screen.x :local.col
  output -156 + (16 * :local.col)
end

to screen.y :local.row
  output 156 - (16 * :local.row)
end

to dir.dx :d
  if :d = 1 [output 1]
  if :d = 3 [output -1]
  output 0
end

to dir.dy :d
  if :d = 0 [output -1]
  if :d = 2 [output 1]
  output 0
end

to dir.bit :d
  if :d = 0 [output 1]
  if :d = 1 [output 2]
  if :d = 2 [output 4]
  output 8
end

to opposite :d
  output remainder (:d + 2) 4
end

to car.tile :i
  output tile.index (item :i :car.col) (item :i :car.row)
end

; Global pixel position, tile centre plus signed progress along the heading.
to car.gx :i
  local "d local "u
  make "d (item :i :car.dir)
  make "u (dir.dx :d)
  output ((item :i :car.col) * 16) + (:u * (item :i :car.offset))
end

to car.gy :i
  local "d local "u
  make "d (item :i :car.dir)
  make "u (dir.dy :d)
  output ((item :i :car.row) * 16) + (:u * (item :i :car.offset))
end

; A parenthesised call to a user-defined procedure may not be the left operand
; of a make or command argument (design 12.7), so each one is bound first.
to dist2 :i :j
  local "dx local "dy local "ax local "ay local "bx local "by
  make "ax (car.gx :i)
  make "ay (car.gy :i)
  make "bx (car.gx :j)
  make "by (car.gy :j)
  make "dx (:ax - :bx)
  make "dy (:ay - :by)
  output (:dx * :dx) + (:dy * :dy)
end

to tile.dist2 :i :tile
  local "dx local "dy local "tx local "ty local "tc local "tr local "gx local "gy
  make "tc (tile.col :tile)
  make "tr (tile.row :tile)
  make "tx (:tc * 16)
  make "ty (:tr * 16)
  make "gx (car.gx :i)
  make "gy (car.gy :i)
  make "dx (:gx - :tx)
  make "dy (:gy - :ty)
  output (:dx * :dx) + (:dy * :dy)
end

