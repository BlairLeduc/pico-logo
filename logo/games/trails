; Turtle Trails -- an original maze-chase game themed on the Logo turtle.
; Load and play:  load "trails   trails
;
; See docs/turtle-trails-design.md.  The tile map is the only source of truth:
; movement, bug decisions, painting and the board on screen all read the same
; cell, and nothing reads canvas colour.  There are no picture assets --
; setup.palette defines every colour and setup.tiles draws the whole tile bank
; with the pen, so the picture and the logic cannot drift apart.
;
; Four interpreter rules govern this file:
;   * there is no >= or <=; write  not (a < b)
;   * a call's last argument absorbs trailing infix, so a call *inside* an
;     expression needs parenthesising: (item :i :a.dir) * (item :i :a.off).
;     This is ordinary Logo, not a defect -- and note it cuts the other way
;     too: the outermost parens of `make "v (:a + 1)` are redundant, because
;     the last argument would absorb the whole expression anyway.  They are
;     not free (about 15 % of such a statement), so do not add them by habit.
;   * a bracketed list literal cannot span lines in a loadable file, so the
;     map gets one complete statement per row
;   * a `;` inside a bracketed list starts a comment and silently swallows
;     the rest of the procedure; keep semicolons out of printed lists
;   * every drawing sequence lives inside one  ask 7 [...]
;
; A fifth rule was here until 2026-08-01 and is gone: a call to a procedure
; defined in this file could not sit inside a parenthesised arithmetic
; expression (`setx ((tile.x :c) - 4)` raised ") without (").  That was B7,
; and it is fixed; the locals this file introduces to work around it are
; harmless but no longer required.

; -------------------------------------------------------------------------
; Palette slots.  Slot 255 is the reserved transparent index and cannot be a
; background, so black gets slot 245 rather than the 255 the design named.
; Game logic compares slots, never RGB.
; -------------------------------------------------------------------------

make "c.bg 245
make "c.speck 246
make "c.trail 247
make "c.dart 248
make "c.swoop 249
make "c.echo 250
make "c.moss 251
make "c.hedge 252
make "c.dizzy 253
make "c.text 254

; Shape slots.  All sprites are mono 8x16 bitmaps drawn 16x16, painted in
; each turtle's pen colour.
make "sh.walk 1        ; 1..3 turtle walk cycle
make "sh.bug 4         ; 4..5 bug body animation
make "sh.wings 6       ; returning wings, rotated by heading
make "sh.bonus 7       ; current bonus shape, redefined at level setup
make "sh.shell 10      ; 10..15 shell-withdraw death sequence

; -------------------------------------------------------------------------
; Tile bank slots.  A map cell is the picture and the rule at once, so the
; slots are ordered to make every question the game asks the map a single
; comparison:
;
;    0        off the board -- painted as background
;    1        hedge and dead space
;    2        nest floor and door: the hedge picture, but bugs may enter
;    3..18    open path, one variant per walkable-neighbour mask
;   19..34    the same path carrying a speck
;   35..50    the same path carrying a power blossom
;   51..54    build.map's scratch codes, all replaced before the map is read
;
; So a cell is walkable above :sl.nest, paintable from :sl.speck, and a
; blossom from :sl.bloss; painting one subtracts 16 or 32 to reach the plain
; variant of the same shape.  The mask is 8 up + 4 left + 2 down + 1 right
; over the walkable neighbours -- exactly what decides where the pen's round
; cap left a corner, so a variant per mask gives a pen-carved board with no
; pen.
make "sl.hedge 1
make "sl.nest 2
make "sl.path 3
make "sl.speck 19
make "sl.bloss 35
make "sc.walk 50       ; build.map scratch: :sc.walk + the tile code

; The board is 28x36 cells of 8 pixels centred on the 320x320 screen, but a
; bake always starts at the top left corner of the graphics area, so the map
; is at least the whole screen -- 40 cells each way -- and the board sits at
; this offset inside it.  The ring of empty cells around the board is also
; what lets tile.at drop its bounds tests: a step off the board lands on
; padding, which reads 0.
;
; The map is taller than the screen, and the rows past it hold the finished
; board.  Deriving a cell's variant costs Logo arithmetic no game wants to
; pay at every level start, and the world is 608 pixels tall against a
; 320-pixel screen, so nothing ever samples them.  (A live scrolling view
; would: P9 M4 must move this copy elsewhere if it ever lands.)
make "sl.dc 6
make "sl.dr 2
make "sl.keep 40

; -------------------------------------------------------------------------
; The map.  Thirty-six encoded 28-character words, one `make` per line: the
; parser drops multi-line parenthesised expressions inside procedure bodies,
; and a bracketed literal cannot span lines in a loadable file.
;
; Letters, not digits, because a row of digits would be read as a number and
; lose its leading zeros.  A=dead space or hedge, B=painted or intrinsically
; empty path, C=unpainted path, D=power blossom, E=tunnel, F=nest floor,
; G=nest door.
;
; Rows 1..3 carry the score line, rows 4..34 the hedge maze, rows 35..36 the
; spare lives and the bonus history.
; -------------------------------------------------------------------------

make "tt.map []
make "tt.map lput "AAAAAAAAAAAAAAAAAAAAAAAAAAAA :tt.map
make "tt.map lput "AAAAAAAAAAAAAAAAAAAAAAAAAAAA :tt.map
make "tt.map lput "AAAAAAAAAAAAAAAAAAAAAAAAAAAA :tt.map
make "tt.map lput "AAAAAAAAAAAAAAAAAAAAAAAAAAAA :tt.map
make "tt.map lput "ACCCCCCCCCCCCCCCCCCCCCCCCCCA :tt.map
make "tt.map lput "ACAAAACAAAAACAACAAAAACAAAACA :tt.map
make "tt.map lput "ADAAAACAAAAACAACAAAAACAAAADA :tt.map
make "tt.map lput "ACAAAACAAAAACAACAAAAACAAAACA :tt.map
make "tt.map lput "ACCCCCCAACCCCCCCCCCAACCCCCCA :tt.map
make "tt.map lput "ACACAAAAACAAAAAAAACAAAAACACA :tt.map
make "tt.map lput "ACACAAAAACAAAAAAAACAAAAACACA :tt.map
make "tt.map lput "ACCCCCCAACCCCAACCCCAACCCCCCA :tt.map
make "tt.map lput "AAAAAACAAAAACAACAAAAACAAAAAA :tt.map
make "tt.map lput "AAAAAACAAAAACAACAAAAACAAAAAA :tt.map
make "tt.map lput "AAAAAACBBBBBBBBBBBBBBCAAAAAA :tt.map
make "tt.map lput "AAAAAACAABAAAGGAAABAACAAAAAA :tt.map
make "tt.map lput "AAAAAACAABAFFFFFFABAACAAAAAA :tt.map
make "tt.map lput "EEEEEECAABAFFFFFFABAACEEEEEE :tt.map
make "tt.map lput "AAAAAACAABAFFFFFFABAACAAAAAA :tt.map
make "tt.map lput "AAAAAACAABAAAAAAAABAACAAAAAA :tt.map
make "tt.map lput "AAAAAACBBBBBBBBBBBBBBCAAAAAA :tt.map
make "tt.map lput "AAAAAAAAABAABAABAABAAAAAAAAA :tt.map
make "tt.map lput "AAAAAAAAABAABAABAABAAAAAAAAA :tt.map
make "tt.map lput "ACCCCCCCCCAACBBCAACCCCCCCCCA :tt.map
make "tt.map lput "ACAAAACAAAAACAACAAAAACAAAACA :tt.map
make "tt.map lput "ACAAAACAAAAACAACAAAAACAAAACA :tt.map
make "tt.map lput "EEECCCCAAAAACCCCAAAAACCCCEEE :tt.map
make "tt.map lput "AAACAACAAAAAACCAAAAAACAACAAA :tt.map
make "tt.map lput "AAACAACAAAAAACCAAAAAACAACAAA :tt.map
make "tt.map lput "ACCCCCCAACCCCCCCCCCAACCCCCCA :tt.map
make "tt.map lput "ACAAAACAACAAAAAAAACAACAAAACA :tt.map
make "tt.map lput "ADAAAACAACAAAAAAAACAACAAAADA :tt.map
make "tt.map lput "ACCCCCCCCCCCCCCCCCCCCCCCCCCA :tt.map
make "tt.map lput "AAAAAAAAAAAAAAAAAAAAAAAAAAAA :tt.map
make "tt.map lput "AAAAAAAAAAAAAAAAAAAAAAAAAAAA :tt.map
