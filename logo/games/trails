; -------------------------------------------------------------------------
; Fixed map landmarks.  All in map coordinates: column 1..28, row 1..36.
; -------------------------------------------------------------------------

make "tt.tunnels [18 27]        ; the two wrap-around rows
make "tt.calm.rows [15 24]      ; a hunting bug may not turn upward here...
make "tt.calm.cols [13 16]      ; ...in these columns, so it cannot camp
make "tt.door.col 14            ; the nest door and the column bugs leave by
make "tt.door.row 16
make "tt.gate.col 14            ; the garden gate: where a bonus shape appears
make "tt.gate.row 21
make "tt.start.col 14           ; the turtle's tile at a level or life start
make "tt.start.row 24

; Indexed by turtle number + 1, so entry 1 is the turtle and 2..5 the bugs.
make "tt.home.col [14 14 14 12 17]
make "tt.home.row [24 15 18 18 18]
make "tt.corner.col [14 26 3 27 2]
make "tt.corner.row [24 2 2 36 36]
make "tt.bug.pc [0 0 0 0 0]     ; filled by setup.palette

; Bonus shape bitmaps, chosen by level.  One statement per row: a bracketed
; literal cannot span lines in a loadable file.
make "tt.shapes []
make "tt.shapes lput [0 0 0 24 24 60 60 126 126 255 255 0 0 0 0 0] :tt.shapes
make "tt.shapes lput [0 0 0 255 255 255 255 255 255 255 255 255 0 0 0 0] :tt.shapes
make "tt.shapes lput [0 0 24 60 126 255 255 255 255 255 255 231 0 0 0 0] :tt.shapes
make "tt.shapes lput [0 0 24 60 126 255 255 255 255 126 60 24 0 0 0 0] :tt.shapes
make "tt.shapes lput [0 60 126 255 255 255 255 255 255 255 255 126 60 0 0 0] :tt.shapes
make "tt.shapes lput [0 24 24 60 255 255 126 60 60 102 102 195 0 0 0 0] :tt.shapes
make "tt.shapes lput [0 126 255 195 207 219 219 216 220 199 255 126 0 0 0 0] :tt.shapes
make "tt.shapes lput [0 0 126 255 255 255 126 126 60 60 24 24 0 0 0 0] :tt.shapes

; Session high score and the bonus history: both outlive a game, so they are
; set up once at load.
make "tt.high 0
make "tt.history []

; -------------------------------------------------------------------------
; Map access.  The map is the C tile map, one byte a cell, so a junction
; lookup is an index rather than the 36 + 28 cons cells a list of row lists
; cost -- and the board is drawn from the very cells the rules read.  Board
; coordinates are 1..28 by 1..36; the map is the whole screen, so both are
; shifted by the board's offset inside it.
;
; A step off the board lands on the empty ring around it and reads 0, which
; is neither walkable nor nest, so no bounds test is needed here.  next.col
; already turns a step off a non-tunnel row into column 0.
;
; The offsets are written out as 6 and 2 rather than read from :sl.dc and
; :sl.dr.  tile.at is the most-called procedure in the game, a dynamically
; scoped name cannot be cached, and those two lookups cost more than the rest
; of the procedure put together -- 3.5 % of a frame on the host.  The tests
; pin the two spellings against each other.
; -------------------------------------------------------------------------

to tile.at :col :row
  output (tile (:col + 6) (:row + 2))
end

; Painting rewrites a cell and allocates nothing.
to set.tile :col :row :value
  settile (:col + 6) (:row + 2) :value
end

; Repaint one board cell from the map, covering whatever the pen left there.
to stamp.tile :col :row
  stamptile (:col + 6) (:row + 2)
end

to walk? :slot
  output (:slot > :sl.nest)
end

to tunnel.row? :row
  output (member? :row :tt.tunnels)
end

; -------------------------------------------------------------------------
; Geometry.  Tile centres sit at x = -108 + 8(col-1) and y = 140 - 8(row-1),
; so the 28x36 board fills 224x288 pixels centred on the 320x320 screen.
; Directions are 1 up, 2 left, 3 down, 4 right -- also the tie-break order.
; -------------------------------------------------------------------------

to tile.x :col
  output (-108 + (8 * (:col - 1)))
end

to tile.y :row
  output (140 - (8 * (:row - 1)))
end

to dir.dc :d
  if :d = 2 [output -1]
  if :d = 4 [output 1]
  output 0
end

to dir.dr :d
  if :d = 1 [output -1]
  if :d = 3 [output 1]
  output 0
end

to dir.heading :d
  if :d = 1 [output 0]
  if :d = 2 [output 270]
  if :d = 3 [output 180]
  output 90
end

to opposite :d
  output (1 + (remainder (:d + 1) 4))
end

; The tunnel rows are the only place where column 1 and column 28 are
; neighbours; everywhere else stepping off the board lands on code 0.
to next.col :col :row :d
  local "c local "dc
  make "dc (dir.dc :d)
  make "c (:col + :dc)
  if :c < 1 [ifelse (tunnel.row? :row) [output 28] [output 0]]
  if :c > 28 [ifelse (tunnel.row? :row) [output 1] [output 0]]
  output :c
end

to next.row :row :d
  output (:row + (dir.dr :d))
end

to open? :col :row :d
  output (walk? (tile.at (next.col :col :row :d) (next.row :row :d)))
end

; Nest floor and door are not ordinary paths: only bugs in a nest state may
; cross them, which is what makes the door one-way for everyone else.
to nest.open? :col :row :d
  local "k
  make "k (tile.at (next.col :col :row :d) (next.row :row :d))
  output (:k > :sl.hedge)
end

