make "tt.map lput "ACAACAAAACAAAAAAAACAAAACAACA :tt.map ; 11
make "tt.map lput "ACCCCCCAACCCCAACCCCAACCCCCCA :tt.map ; 12
make "tt.map lput "AAAAAACAAAAACAACAAAAACAAAAAA :tt.map ; 13
make "tt.map lput "AAAAAACAAAAACAACAAAAACAAAAAA :tt.map ; 14
make "tt.map lput "AAAAAACBBBBBBBBBBBBBBCAAAAAA :tt.map ; 15
make "tt.map lput "AAAAAACAABAAAGGAAABAACAAAAAA :tt.map ; 16
make "tt.map lput "AAAAAACAABAFFFFFFABAACAAAAAA :tt.map ; 17
