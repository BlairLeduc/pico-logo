  setpalette :c.hedge [42 106 66]
  setpalette :c.dizzy [70 96 232]
  setpalette :c.text [236 240 246]
  make "tt.bug.pc (list 0 :c.dart :c.swoop :c.echo :c.moss)
end

to setup.shapes
  putsh :sh.walk [24 24 60 126 255 126 126 126 126 126 255 126 60 24 0 0]
  putsh (:sh.walk + 1) [24 24 60 126 126 126 126 126 126 126 126 126 60 24 0 0]
  putsh (:sh.walk + 2) [24 24 60 255 126 126 126 126 126 126 126 255 60 24 0 0]
  putsh :sh.bug [24 36 60 126 255 255 255 255 255 255 255 126 189 60 0 0]
  putsh (:sh.bug + 1) [24 36 60 126 255 255 255 255 255 255 255 126 90 102 0 0]
  putsh :sh.wings [0 0 102 255 255 255 102 24 24 0 0 0 0 0 0 0]
  putsh :sh.shell [0 24 60 126 126 126 126 126 126 126 126 126 60 24 0 0]
  putsh (:sh.shell + 1) [0 0 60 126 126 126 126 126 126 126 126 126 60 0 0 0]
