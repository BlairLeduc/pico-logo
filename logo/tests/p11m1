; P11 M1 -- what an Asteroids frame actually costs on hardware.
;
;   erall                        <-- REQUIRED, see below
;   load "asteroids   (do NOT run the game)
;   load "p11m1
;   p11m1
;
; M0 measured the drawing two thirds of the frame on a static scene and the
; design was re-cut around it (docs/asteroids-design.md section 12).  The
; remaining third -- physics, wrap arithmetic, the `if` chains that walk the
; slots -- is estimated, and the worst case fits its 66.7 ms budget by 0.5 ms.
; That is not a margin, so this script measures a real `play.frame`.
;
; It runs the frame at 6, 9 and 12 rocks, the same three points M0 used, so
; the two sets of numbers subtract.  For each it reports the body and the
; present apart, because a frame that misses its budget is a different problem
; depending on which half is over -- and the present is the half no game-side
; lever reaches.
;
; Manual refresh, not `sync`: the number wanted is the work, not the cadence.
; `sync` would wait out the rest of the frame and report the wait.  That also
; means the figures here are what the frame COSTS, and the game will be at 15
; fps or slower, never faster.
;
; Run it in graphics mode -- `setup.level` leaves the screen there.  In text
; mode `screen_gfx_blit_dirty` returns immediately, so the present column
; reads zero and the frame figure is a Logo body with no present in it, which
; is the correction P9 had to make to its whole first series of numbers.
;
; `erall` is not optional.  MAX_PROCEDURES is a hard 128; the game defines 21
; and this file adds 4, but a workspace still holding another program can run
; out of procedure slots and `load` stops with `out of space` -- the procedure
; table talking, not memory.
;
; The storage columns are the other half of M1's question.  An Asteroids frame
; is NOT free the way Galaxian's is: `.setitem` of a number interns it, so
; twelve rocks mint 36 atoms a frame and the contract is a flat working set
; rather than a zero (design section 14).  `reclaim` is what holds it, and it
; is load-bearing here rather than a precaution -- so the run reports free
; storage at the start, after 300 frames, and after a recycle.  Before should
; be near after, and both far from zero.
;
; The report goes to `p11m1.txt` as well as the screen, because numbers on the
; PicoCalc's display cannot be copied anywhere.  Runs append.

make "p11m1.frames 300

make "p11m1.body (list 0 0 0)      ; ms, mean
make "p11m1.pres (list 0 0 0)      ; ms, mean
make "p11m1.lo (list 0 0 0)        ; ms, whole frame
make "p11m1.hi (list 0 0 0)

; `play.frame` without its `sync`.  THIS MUST STAY IN STEP WITH THE GAME: it
; is the same statements in the same order, and it is spelled out here rather
; than calling `play.frame` because the present has to be timed on its own and
; `sync` is the last thing `play.frame` does.  `test_asteroids.c` pins that
; this draws what a real frame draws.
to frame.body
  poll.input
  make "frame.count :frame.count + 1
  step.all
  clean
  draw.all
  draw.hud
  reclaim
end

to measure :k :n
  local "b local "p local "one local "t0 local "lo local "hi
  make "level.rocks :n
  init.game
  setup.level
  setrefresh "manual
  make "b 0
  make "p 0
  make "lo 99999
  make "hi 0
  repeat :p11m1.frames [
    make "t0 ticks
    frame.body
    make "one ticks - :t0
    make "b :b + :one
    make "t0 ticks
    refresh
    make "one :one + (ticks - :t0)
    make "p :p + (ticks - :t0)
    if :one < :lo [make "lo :one]
    if :one > :hi [make "hi :one]
  ]
  .setitem :k :p11m1.body :b / :p11m1.frames
  .setitem :k :p11m1.pres :p / :p11m1.frames
  .setitem :k :p11m1.lo :lo
  .setitem :k :p11m1.hi :hi
end

; Printed twice -- once to the file, once to the screen -- so it is one list of
; lines rather than two that can drift apart.  Punctuation is spelled out in
; words: every mark in a printed list is tokenised as a word of its own, so
; `clear+redraw` comes out as `clear + redraw` and `--` as `- -`.
to line.for :k :n
  pr (se :n [rocks])
  pr (se [  body] item :k :p11m1.body [ms   present] item :k :p11m1.pres [ms])
  pr (se [  frame] (item :k :p11m1.body) + (item :k :p11m1.pres)
      [ms   min] item :k :p11m1.lo [ms   max] item :k :p11m1.hi [ms])
end

to p11m1.report
  pr [P11 M1 what an Asteroids frame costs]
  pr (se [frames per point] :p11m1.frames)
  pr []
  line.for 1 6
  line.for 2 9
  line.for 3 12
  pr []
  pr [budget at 15 fps is 66.7 ms]
  pr (se [design estimate at 12 rocks is 66.2 ms])
  pr []
  pr (se [nodes at start] :n0)
  pr (se [nodes at end  ] :n1)
  pr (se [after recycle ] :n2)
  pr []
end

to p11m1
  local "n0 local "n1 local "n2
  recycle
  make "n0 nodes
  measure 1 6
  measure 2 9
  measure 3 12
  make "n1 nodes
  recycle
  ; Read the recovered figure HERE, not inside the report: printing builds a
  ; `sentence` per line, so a `nodes` evaluated down there reads the report's
  ; own garbage back as if the recycle had under-recovered.  P10's script lost
  ; its first hardware run to exactly that.
  make "n2 nodes
  setrefresh "auto
  textscreen
  open "p11m1.txt
  setwrite "p11m1.txt
  p11m1.report
  setwrite []
  close "p11m1.txt
  p11m1.report
  pr [Also written to p11m1.txt]
end
